APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional public base URL for the KYC selfie QR link (e.g. https://xxxx.ngrok-free.app); empty = auto Wi-Fi IP
KYC_MOBILE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# KRYVEX CUSTODIAL REAL WALLET CONFIGURATION
# ==============================================================================
# Master HD Mnemonic for deriving unique user deposit addresses (Tron coin type 195)
DEPOSIT_HD_MNEMONIC=""

# Tron Network: 'mainnet', 'nile', 'shasta'
TRON_NETWORK=mainnet

# Optional TronGrid API Key (prevents rate limiting on polling)
TRONGRID_API_KEY=""

# TRC-20 USDT Smart Contract Addresses
# Mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t | Nile Testnet: TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
DEPOSIT_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
WITHDRAW_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# Company Hot Vault C (Destination of sweeps & source of payouts)
WITHDRAW_FROM_ADDRESS=""
WITHDRAW_PRIVATE_KEY=""

# Operational Switches
DEPOSIT_ONCHAIN_ENABLED=true
DEPOSIT_SWEEP_ENABLED=false
WITHDRAW_ONCHAIN_ENABLED=false

# Confirmations
TRON_REQUIRED_CONFIRMATIONS=19
TRON_POLL_INTERVAL_SECONDS=10

